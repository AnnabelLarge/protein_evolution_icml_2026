        "attn_weights": false
    },
    "save_arrs": false,
    "save_per_sample_losses": false,
    "record_metrics_every_n_steps": 500,
    "checkpoint_every_t_seconds": 1800,

    "anc_model_type": "transformer",
    "anc_enc_config": {"initial_embed_module": "EmbeddingWithPadding",
                       "first_block_module": "RoPETransfBlock",
                       "subsequent_block_module": "RoPETransfBlock",
                       "hidden_dim": 756,
                       "num_blocks": 6,
                       "num_heads": 6,
                       "dropout": 0.2,
                       "max_position_embeddings": 3000
                       },

    "desc_model_type": "transformer",
    "desc_dec_config": {"initial_embed_module": "EmbeddingWithPadding",
                       "first_block_module": "RoPETransfBlock",
                       "subsequent_block_module":"RoPETransfBlock",
                       "hidden_dim": 756,
                       "num_blocks": 6,
                       "num_heads": 6,
                       "dropout": 0.2,
                       "max_position_embeddings": 3000
                       },

    "pred_model_type": "feedforward",
    "pred_config": {
        "postproc_model_type": "feedforward",
        "use_bias": true,
        "use_anc_emb": true,
        "use_desc_emb": true,
        "use_prev_align_info": true,
        "layer_sizes": [500],
        "dropout": 0.20,
        "t_per_sample": true 
