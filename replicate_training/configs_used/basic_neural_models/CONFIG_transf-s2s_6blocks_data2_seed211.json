        "every_k_schedule": 1
    },
    "early_stop_cond1_atol": 1e-3,
    "early_stop_cond2_gap": 0.1,
    "patience": 5,
    "update_grads": true,
    "use_scan_fns": false,

    "interms_for_tboard": {
        "sow_outputs": false,
        "embeddings": false,
        "gradients": false,
        "weights": false,
        "optimizer": false,
